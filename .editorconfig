root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = false

# PowerShell 5.1 读取无 BOM 的 .ps1 会按系统 ANSI 解码，中文注释和字符串会变乱码并报语法错误。
# 这两个脚本必须保持 UTF-8 带 BOM。
[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.lua]
charset = utf-8
end_of_line = lf

[*.md]
charset = utf-8
end_of_line = lf
